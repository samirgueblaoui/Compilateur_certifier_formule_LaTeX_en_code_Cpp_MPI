\if@ocaml
% ****************** formulaToSkel ****************************
\newcommand{\formulaToSkel}[2][]{%
  \setkeys{formToSkel}{
  	visible = true,
  	language = OCaml,
    #1
  } 
	\typeout{!!! Add a new formula !!!}
	\ifthenelse{\equal{true}{\cmdKV@formToSkel@visible}}{\todo[inline,color=blue!40]{#2}}{}
	\pyc{formToSkel.formulaToSkel(r'#2')}
	\begingroup\edef\x{\endgroup 
		\noexpand\pyc{formToSkel.formulaToSkelBis(r'\cmdKV@formToSkel@label',r'\cmdKV@formToSkel@language',r'\showlineno')}}\x
	\begingroup\edef\x{\endgroup 
		\noexpand\pyc{formToSkel.formulaToSkelEnd('\formulaToSkelServer','\formulaToSkelServerDir','\formulaToSkelServerAccess','\formulaToSkelLocalLib')}}\x
}
